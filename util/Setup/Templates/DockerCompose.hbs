services:
{{#if EnableBuiltInMsSql}}
  mssql:
    image: ghcr.io/deepsafer/mssql:{{{CoreVersion}}}
    container_name: deepsafer-mssql
    restart: always
    stop_grace_period: 60s
    volumes:
{{#if MssqlDataDockerVolume}}
      - mssql_data:/var/opt/mssql/data
{{else}}
      - ../mssql/data:/var/opt/mssql/data
{{/if}}
      - ../logs/mssql:/var/opt/mssql/log
      - ../mssql/backups:/etc/deepsafer/mssql/backups
    env_file:
      - mssql.env
      - ../env/uid.env
      - ../env/mssql.override.env

{{/if}}
  web:
    image: ghcr.io/deepsafer/web:{{{WebVersion}}}
    container_name: deepsafer-web
    restart: always
    volumes:
      - ../web:/etc/deepsafer/web
    env_file:
      - global.env
      - ../env/uid.env

  attachments:
    image: ghcr.io/deepsafer/attachments:{{{CoreVersion}}}
    container_name: deepsafer-attachments
    restart: always
    volumes:
      - ../core/attachments:/etc/deepsafer/core/attachments
    env_file:
      - global.env
      - ../env/uid.env

  api:
    image: ghcr.io/deepsafer/api:{{{CoreVersion}}}
    container_name: deepsafer-api
    restart: always
    volumes:
      - ../core:/etc/deepsafer/core
      - ../ca-certificates:/etc/deepsafer/ca-certificates
      - ../logs/api:/etc/deepsafer/logs
    env_file:
      - global.env
      - ../env/uid.env
      - ../env/global.override.env
    networks:
      - default
      - public

  identity:
    image: ghcr.io/deepsafer/identity:{{{CoreVersion}}}
    container_name: deepsafer-identity
    restart: always
    volumes:
      - ../identity:/etc/deepsafer/identity
      - ../core:/etc/deepsafer/core
      - ../ca-certificates:/etc/deepsafer/ca-certificates
      - ../logs/identity:/etc/deepsafer/logs
    env_file:
      - global.env
      - ../env/uid.env
      - ../env/global.override.env
    networks:
      - default
      - public

  sso:
    image: ghcr.io/deepsafer/sso:{{{CoreVersion}}}
    container_name: deepsafer-sso
    restart: always
    volumes:
      - ../identity:/etc/deepsafer/identity
      - ../core:/etc/deepsafer/core
      - ../ca-certificates:/etc/deepsafer/ca-certificates
      - ../logs/sso:/etc/deepsafer/logs
    env_file:
      - global.env
      - ../env/uid.env
      - ../env/global.override.env
    networks:
      - default
      - public

  admin:
    image: ghcr.io/deepsafer/admin:{{{CoreVersion}}}
    container_name: deepsafer-admin
    restart: always
{{#if EnableBuiltInMsSql}}
    depends_on:
      - mssql
{{/if}}
    volumes:
      - ../core:/etc/deepsafer/core
      - ../ca-certificates:/etc/deepsafer/ca-certificates
      - ../logs/admin:/etc/deepsafer/logs
    env_file:
      - global.env
      - ../env/uid.env
      - ../env/global.override.env
    networks:
      - default
      - public

  icons:
    image: ghcr.io/deepsafer/icons:{{{CoreVersion}}}
    container_name: deepsafer-icons
    restart: always
    volumes:
      - ../ca-certificates:/etc/deepsafer/ca-certificates
      - ../logs/icons:/etc/deepsafer/logs
    env_file:
      - global.env
      - ../env/uid.env
    networks:
      - default
      - public

  notifications:
    image: ghcr.io/deepsafer/notifications:{{{CoreVersion}}}
    container_name: deepsafer-notifications
    restart: always
    volumes:
      - ../ca-certificates:/etc/deepsafer/ca-certificates
      - ../logs/notifications:/etc/deepsafer/logs
    env_file:
      - global.env
      - ../env/uid.env
      - ../env/global.override.env
    networks:
      - default
      - public

  events:
    image: ghcr.io/deepsafer/events:{{{CoreVersion}}}
    container_name: deepsafer-events
    restart: always
    volumes:
      - ../ca-certificates:/etc/deepsafer/ca-certificates
      - ../logs/events:/etc/deepsafer/logs
    env_file:
      - global.env
      - ../env/uid.env
      - ../env/global.override.env
    networks:
      - default
      - public

  nginx:
    image: ghcr.io/deepsafer/nginx:{{{CoreVersion}}}
    container_name: deepsafer-nginx
    restart: always
    depends_on:
      - web
      - admin
      - api
      - identity
{{#if HasPort}}
    ports:
{{#if HttpPort}}
      - '{{{HttpPort}}}:8080'
{{/if}}
{{#if HttpsPort}}
      - '{{{HttpsPort}}}:8443'
{{/if}}
{{/if}}
    volumes:
      - ../nginx:/etc/deepsafer/nginx
      - ../letsencrypt:/etc/letsencrypt
      - ../ssl:/etc/ssl
      - ../logs/nginx:/var/log/nginx
    env_file:
      - ../env/uid.env
    networks:
      - default
      - public

{{#if EnableKeyConnector}}
  key-connector:
    image: ghcr.io/deepsafer/key-connector:{{{KeyConnectorVersion}}}
    container_name: deepsafer-key-connector
    restart: always
    volumes:
      - ../key-connector:/etc/deepsafer/key-connector
      - ../ca-certificates:/etc/deepsafer/ca-certificates
      - ../logs/key-connector:/etc/deepsafer/logs
    env_file:
      - ../env/uid.env
      - ../env/key-connector.override.env
    networks:
      - default
      - public
{{/if}}
{{#if EnableScim}}

  scim:
    image: ghcr.io/deepsafer/scim:{{{CoreVersion}}}
    container_name: deepsafer-scim
    restart: always
    volumes:
      - ../core:/etc/deepsafer/core
      - ../ca-certificates:/etc/deepsafer/ca-certificates
      - ../logs/scim:/etc/deepsafer/logs
    env_file:
      - global.env
      - ../env/uid.env
      - ../env/global.override.env
    networks:
      - default
      - public
{{/if}}
{{#if MssqlDataDockerVolume}}

volumes:
  mssql_data:
    labels:
      ye.vault.deepsafer.product: deepsafer
{{/if}}

networks:
  default:
    internal: true
  public:
    internal: false
